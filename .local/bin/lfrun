#!/bin/sh
# lf with image previews. On X11 with ueberzug(pp) images are drawn as real
# pictures; everywhere else (macOS, Wayland, ssh, tty) ~/.config/lf/preview
# falls back to chafa, which draws them with text characters.
set -e

if [ -n "$SSH_CLIENT$SSH_TTY" ] || [ -z "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ] ||
  [ "$(uname)" = Darwin ]; then
  exec lf "$@"
fi

if command -v ueberzugpp >/dev/null 2>&1; then
  ueberzug=ueberzugpp
elif command -v ueberzug >/dev/null 2>&1; then
  ueberzug=ueberzug
else
  exec lf "$@"
fi

mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/lf"
export FIFO_UEBERZUG="${XDG_CACHE_HOME:-$HOME/.cache}/lf/ueberzug-$$"

cleanup() {
  exec 3>&-
  rm -f "$FIFO_UEBERZUG"
}

mkfifo "$FIFO_UEBERZUG"
"$ueberzug" layer -s -p json <"$FIFO_UEBERZUG" &
exec 3>"$FIFO_UEBERZUG"
trap cleanup EXIT
lf "$@" 3>&-
