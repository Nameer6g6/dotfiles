# Window manager, keyboard, terminal and dev tools.  Install with:
#   brew bundle --file=~/dotfiles/macos/Brewfile

tap "felixkratz/formulae"  # borders
tap "hashicorp/tap"        # terraform
tap "nikitabobko/tap"      # aerospace

# --- Window management (xmonad replacement) ---
cask "nikitabobko/tap/aerospace"     # tiling WM with xmonad-style workspaces across monitors
brew "felixkratz/formulae/borders"   # focused-window border, like xmonad's borderWidth
cask "karabiner-elements"            # Linux keyboard layout: Ctrl/Super/Alt, Caps<->Esc
brew "displayplacer"                 # arrange monitors / pick the main one from the shell, like xrandr
cask "alt-tab"                       # Windows/Linux-style Alt+Tab window switcher
brew "defaultbrowser"                # set the default browser (Chrome) from bootstrap.sh

# --- Terminal & shell ---
# Alacritty: the cask is disabled (fails Gatekeeper), bootstrap.sh installs it from GitHub
brew "zsh-syntax-highlighting"
brew "tmux"
brew "neovim"
brew "eza"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "lf"
brew "highlight"
brew "jq"
brew "tree"
brew "wget"
brew "btop"
brew "htop"
brew "terminal-notifier"
# coreutils also ships a `gfold` (GNU fold), so keep this one unlinked;
# aliasrc points `gfold` at it on macOS
brew "gfold", link: false
brew "universal-ctags"
brew "stylua"

# GNU userland so the Linux scripts in .local/bin behave the same.
# These install as g-prefixed tools (gsed, gdate...); bootstrap.sh's PATH
# setup in .zprofile puts the unprefixed gnubin versions first.
brew "coreutils"
brew "gnu-sed"
brew "grep"
brew "findutils"
brew "gawk"

# --- Dev ---
brew "git"
brew "gh"
brew "gopass"
brew "gnupg"
brew "pinentry-mac"   # GUI passphrase prompt for gpg-agent
brew "asdf"
brew "kubernetes-cli"
brew "hashicorp/tap/terraform"
brew "awscli"
cask "azure-cli"
cask "gcloud-cli"

# --- Fonts ---
cask "font-fira-code"
cask "font-fira-code-nerd-font"   # icons for eza --icons / lf
